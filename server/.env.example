# ================================================================
# UVYANTRA CRM — переменные окружения
# Скопируйте в .env и заполните своими значениями
# ================================================================

# PostgreSQL — Railway создаёт автоматически при добавлении плагина Postgres
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Секрет для подписи JWT-токенов — сгенерируйте случайную строку
JWT_SECRET="change-me-to-a-random-secret-string"

# Порт (Railway подставляет автоматически через переменную PORT)
PORT=3000

# Telegram бот (для уведомлений мастеру)
TG_BOT_TOKEN="8678659173:AAGWOl_7L7uqSvVjY1u9zEGiHDJuyoKAUDs"
TG_MASTER_CHAT_ID="-5131504174"

NODE_ENV=production
